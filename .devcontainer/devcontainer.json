{
  "name": "Starten met IoT precisielandbouw",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "python -m ipykernel install --user --name python3 --display-name 'Python 3 (ipykernel)'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "jupyter.askForKernelRestart": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
